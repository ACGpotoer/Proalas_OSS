# DAP 本地覆盖（可选）。复制为 .env.dap 后生效。
# 勿提交含密钥的文件。

FLASK_SECRET_KEY=oss-local-dev-only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

PROALAS_OSS=1
ALAS_UPSTREAM=http://127.0.0.1:22267
DAP_PORT=8080

CONFIG_DIR=./config
DATABASE_PATH=./dap_data/proalas.db
COMMANDS_DIR=./dap_commands
ANNOUNCEMENT_PATH=./dap_data/更新公告.md

